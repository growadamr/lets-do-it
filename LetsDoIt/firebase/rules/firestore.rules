rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: check if user is the owner of a user-scoped resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: check if user is a member of a conversation
    function isConversationMember(conversationId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    
    // Helper function: check if user is a participant in the given list
    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }
    
    // ==================== USERS ====================
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      
      // ==================== CONTACTS ====================
      match /contacts/{contactUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false; // Managed by Cloud Functions
      }
      
      // ==================== SELECTIONS ====================
      match /selections/{selectionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && 
                         request.resource.data.keys().hasAll(['matched']) == false; // matched set by Cloud Function
        allow delete: if false; // Managed by cleanup Cloud Function
      }
      
      // ==================== ACTIVITY PREFERENCES ====================
      match /activityPreferences/{activityId} {
        allow read, write: if isOwner(userId);
      }

      // ==================== CONTACT ACTIVITY PREFERENCES ====================
      match /contactActivityPreferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
      
      // ==================== CUSTOM ACTIVITIES ====================
      match /customActivities/{activityId} {
        allow read: if isOwner(userId) || 
                       (isAuthenticated() && request.auth.uid in resource.data.visibleTo);
        allow create, update, delete: if isOwner(userId);
      }
      
      // ==================== SCHEDULED ACTIVITIES ====================
      match /scheduledActivities/{scheduleId} {
        allow read, write: if isOwner(userId);
      }
      
      // ==================== CONVERSATION MEMBERSHIPS ====================
      match /conversationMemberships/{conversationId} {
        allow read: if isOwner(userId);
        // Memberships are created by Cloud Function on conversation creation
        allow create: if false; // Handled by onConversationCreated Cloud Function
        allow update: if isOwner(userId) && 
                        request.resource.data.keys().hasOnly(['lastReadAt', 'muted']);
        allow delete: if false; // Managed by Cloud Functions
      }
    }
    
    // ==================== CONVERSATIONS ====================
    
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && 
                     request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && 
                       request.resource.data.participants.hasAny([request.auth.uid]) &&
                       request.resource.data.keys().hasOnly([
                         'type', 'participants', 'createdBy', 'createdAt',
                         'lastMessage', 'metadata', 'participantNames'
                       ]);
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.participants == resource.data.participants && // Can't change participants on update
                       request.resource.data.keys().hasOnly([
                         'type', 'participants', 'createdBy', 'createdAt',
                         'lastMessage', 'metadata', 'participantNames'
                       ]);
      allow delete: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
      
      // ==================== MESSAGES SUBCOLLECTION ====================
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && 
                         request.resource.data.keys().hasOnly([
                           'senderUid', 'senderName', 'text', 'imageUrl',
                           'linkPreview', 'readBy', 'createdAt'
                         ]) &&
                         request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuthenticated() && 
                         request.auth.uid == resource.data.senderUid ||
                         (request.resource.data.keys().hasOnly(['readBy']) &&
                          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderUid;
      }
    }
    
    // ==================== INVITE CODES ====================
    
    match /inviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if false; // Managed by Cloud Functions
    }
    
    // ==================== PENDING NOTIFICATIONS ====================
    
    match /pendingNotifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if false; // Created by Cloud Functions only
      allow update: if false; // Managed by Cloud Functions
      allow delete: if false; // Managed by cleanup Cloud Function
    }
    
    // ==================== EVENTS ====================

    match /events/{eventId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.invitees;
      allow create: if isAuthenticated() &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.createdBy ||
                        (request.auth.uid in resource.data.invitees &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps'])));
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }
  }
}
